{
    "$schema": "https://schema.tauri.app/config/2",
      "productName": "Spellbound Scents",
        "version": "0.1.0",
          "identifier": "com.spellboundscents.app",
            "build": {
                "beforeBuildCommand": "",
                    "beforeDevCommand": "",
                        "frontendDist": "../public"
                          },
                            "app": {
                                "withGlobalTauri": true,
                                    "security": {
                                          "csp": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' https: data: blob:; style-src 'self' https: 'unsafe-inline'; script-src 'self' https: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https:; frame-src https:;"
                                              },
                                                  "windows": [
                                                        {
                                                                "title": "Spellbound Scents",
                                                                        "width": 400,
                                                                                "height": 800,
                                                                                        "resizable": true,
                                                                                                "fullscreen": false
                                                                                                      }
                                                                                                          ]
                                                                                                            },
                                                                                                              "bundle": {
                                                                                                                  "active": true,
                                                                                                                      "targets": "all",
                                                                                                                          "icon": [
                                                                                                                                "icons/32x32.png",
                                                                                                                                      "icons/128x128.png",
                                                                                                                                            "icons/icon.icns",
                                                                                                                                                  "icons/icon.ico",
                                                                                                                                                        "icons/StoreLogo.png"
                                                                                                                                                            ]
                                                                                                                                                              }
                                                                                                                                                              }
}
